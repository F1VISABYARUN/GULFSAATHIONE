{
  "name": "gulf-saathi-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gulf Saathi: a call harness around OpenAI STT that locks Telugu-English, Indian numbers, names and Gulf Arabic terms so risk checks run on the truth.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "eval:bolna": "tsx eval/bolna/run.ts",
    "audio:bolna": "node eval/bolna/download-audio.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "openai": "^7.62.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
