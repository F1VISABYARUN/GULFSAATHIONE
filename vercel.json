{
  "installCommand": "npm ci --include=dev",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/data/**"
    }
  },
  "crons": [
    {
      "path": "/api/saathi/cron",
      "schedule": "30 3 * * *"
    }
  ]
}