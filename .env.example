OPENAI_API_KEY=
# Models are configurable; verify current names in the OpenAI docs at the venue.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
PORT=3000

# Optional: protects /api/gate, /webhooks/bolna and case files (send as x-saathi-secret header)
SAATHI_SECRET=

# Optional: live place search + transit directions for the call-in assistant (Google Maps Platform)
GOOGLE_MAPS_API_KEY=

# New Saathi backend: outbound check-in calls via Bolna (dry run if empty)
BOLNA_API_KEY=
BOLNA_CHECKIN_AGENT_ID=
# STORE=memory on Vercel (read-only disk) until a database is added
STORE=

# Database on Vercel: Upstash Redis (or Vercel KV) — set these and cases persist
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Cron auth for /api/saathi/cron
CRON_SECRET=
