OPENAI_API_KEY=
# Optional alternative speech providers for /api/saathi/stt
GEMINI_API_KEY=
SARVAM_API_KEY=
# Models are configurable; verify current names in the OpenAI docs at the venue.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
PORT=3000

# API and call-review access (send as x-saathi-secret on trusted server requests)
SAATHI_SECRET=

# Optional: live place search + transit directions for the call-in assistant (Google Maps Platform)
GOOGLE_MAPS_API_KEY=

# New Saathi backend: outbound check-in calls via Bolna (dry run if empty)
BOLNA_API_KEY=
BOLNA_CHECKIN_AGENT_ID=
# Local tests can set STORE=memory. Configure shared Redis for hosted case records.
STORE=

# Database on Vercel: Upstash Redis (or Vercel KV) — set these and cases persist
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Cron auth for /api/saathi/cron
CRON_SECRET=

# Registered family and location message templates
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_PLACE_TEMPLATE_ID=
